table 'Date'
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Year]

	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: [Quarter]

	column 'Month Number'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: [Month Number]

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Year Month Sort'

	column 'Year Month Sort'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: [Year Month Sort]

	partition 'Date' = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2025, 12, 31 ) ),
				    "Year", YEAR ( [Date] ),
				    "Quarter", "Q" & QUARTER ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm yyyy" ),
				    "Year Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				)

